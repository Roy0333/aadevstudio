# Live domain, used for canonical URLs, Open Graph tags, robots.txt and sitemap.xml.
# Copy to .env.local (or set in your hosting provider) before deploying.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Web3Forms access key for the contact form (https://web3forms.com). Public by design, it only allows sending to your inbox.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-access-key
